# OLD DB (read) — has the `websites` table with website name + ad_unit_path.
# Main app project: https://thzgtneujhghoosxvtvy.supabase.co
OLD_SUPABASE_URL=https://thzgtneujhghoosxvtvy.supabase.co
OLD_SUPABASE_SERVICE_KEY=old_db_service_role_key_here

# NEW DB (write) — Mi Reporting DB.
# Project: https://zlzlgjrydvkbszjyiwfi.supabase.co
SUPABASE_URL=https://zlzlgjrydvkbszjyiwfi.supabase.co
SUPABASE_SERVICE_KEY=new_db_service_role_key_here

# GAM Service Account (MCM parent credentials — used to reach the child network)
GAM_CLIENT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GAM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Target child network to report on (e.g. 22862221459)
GAM_NETWORK_CODE=22862221459

# Only websites with this status in the OLD DB `websites.status` are synced
# (e.g. "Approved"). Any other status (Rejected/Pending/etc.) is skipped.
# APPROVED_STATUS=Approved

# Optional overrides
# SYNC_INTERVAL=30            # minutes between syncs (default: 30)
# LOOKBACK_DAYS=30            # max days back to fetch (default: 30). On a fresh DB
#                             # the first run backfills this window; later runs are
#                             # incremental (last stored date - 1 day buffer).
# RETENTION_DAYS=90           # delete rows older than this (default: 90)
# BATCH_SIZE=1000             # rows per Supabase upsert (default: 1000)
# WRITE_RETRIES=3             # retry attempts for Supabase writes (default: 3)
# REPORT_POLL_MAX=300         # report status polls before timeout (default: 300)
# REPORT_DOWNLOAD_TIMEOUT=300 # report download timeout in seconds (default: 300)
# LOG_DIR=logs                # log file directory (default: logs)
